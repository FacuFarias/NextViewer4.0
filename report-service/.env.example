# PostgreSQL / authentication
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pacsdb
DB_USER=pacs
DB_PASSWORD=pacs
AUTH_REQUIRED=true
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/dcm4che/protocol/openid-connect/certs
KEYCLOAK_ISSUER=

# DICOM source and output storage. In AWS prefer an IAM task role instead of
# static keys; these variables are also compatible with MinIO deployments.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
SOURCE_DICOM_BUCKET=dicom-source
SEGMENTATION_BUCKET=dicom-segmentation
SOURCE_DICOM_PREFIX_TEMPLATE=studies/{studyInstanceUID}/series/{seriesInstanceUID}/
REFERENCE_STORAGE_BUCKET=qii-images-for-training
REFERENCE_STORAGE_PREFIX=Anonimizied/
REFERENCE_SCAN_CONCURRENCY=12
REFERENCE_STOW_BATCH_SIZE=20
SEGMENTATION_OUTPUT_PREFIX=dicom-seg
S3_PRESIGN_SECONDS=3600
S3_KMS_KEY_ID=

# Service-to-service PACS publication
PACS_DICOMWEB_URL=http://arc:8080/dcm4chee-arc/aets/DCM4CHEE/rs
PACS_TOKEN_URL=http://keycloak:8080/realms/dcm4che/protocol/openid-connect/token
PACS_CLIENT_ID=nextviewer-report-service
PACS_CLIENT_SECRET=

# Queue defaults
SEGMENTATION_BATCH_SIZE=5
SEGMENTATION_MAX_BATCH_SIZE=20
SEGMENTATION_LEASE_MINUTES=15
